{%- comment -%} PDP: stacked layout — gallery, info grid, collection products. {%- endcomment -%}

<section class="main-product color-{{ section.settings.color_scheme }}">
  {% render 'json-ld-product', product: product %}

  {%- comment -%} — Media — {%- endcomment -%}
  <product-form class="pdp" data-section-id="{{ section.id }}">
    <script type="application/json" class="product-json">
      {{ product | json }}
    </script>

    <div class="pdp-media">
      {% render 'product-gallery', product: product %}

      {%- comment -%} Color variant pills {%- endcomment -%}
      {%- assign color = product.metafields.custom.color.value -%}
      {%- assign siblings = product.metafields.custom.product_siblings.value -%}

      {%- if color != blank -%}
        <div class="pdp-tags">
          <div class="pdp-tag-wrapper" data-color-tag>
            <div class="tag-popover" id="pdp-color-popover" data-color-popover>
              {%- if siblings != blank -%}
                {%- for sibling in siblings -%}
                  {%- assign sibling_color = sibling.metafields.custom.color.value -%}
                  {%- if sibling_color != blank -%}
                    <a href="{{ sibling.url }}" class="tag-popover-item">
                      {% render 'color-swatch', color: sibling_color, class: 'pdp-swatch' %}
                      {{ sibling_color.name | downcase }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
            <button
              type="button"
              class="pdp-tag"
              data-color-trigger
              aria-expanded="false"
              aria-controls="pdp-color-popover"
            >
              {% render 'color-swatch', color: color, class: 'pdp-swatch' %}
              {{ color.name | downcase }}
            </button>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} — Info grid — {%- endcomment -%}
    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      <div class="pdp-info">
        <div class="pdp-info-left">
          <div class="pdp-header">
            <h1 class="text-large">{{ product.title }}</h1>
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                {% render block %}
              {%- endif -%}
            {%- endfor -%}
            <div class="pdp-price" data-product-price data-variant-render="price">
              {% render 'product-price', product: product %}
            </div>
          </div>

          {%- if product.has_only_default_variant == false -%}
            <div class="product-variants">
              {% render 'product-variant-selector', product: product %}
            </div>
          {%- endif -%}

          <div class="pdp-actions" data-variant-render="buy-buttons">
            {% render 'product-buy-buttons', product: product, show_quantity: true %}
          </div>

          <div class="pdp-payment-terms" data-variant-render="payment-terms">
            <klarna-placement
              data-key="credit-promotion-auto-size"
              data-locale="en-GB"
              data-purchase-amount="{{ product.selected_or_first_available_variant.price }}"
            ></klarna-placement>
          </div>

          {%- liquid
            assign discount_block = null
            for block in section.blocks
              if block.type == 'discount_message' and block.settings.message != blank
                assign discount_block = block
                break
              endif
            endfor
          -%}

          <div class="pdp-status-row" data-variant-render="stock-notice">
            {%- if discount_block -%}
              <p class="pdp-promo-message" {{ discount_block.shopify_attributes }}>{{ discount_block.settings.message }}</p>
            {%- endif -%}

            {%- if product.selected_or_first_available_variant.available -%}
              <p class="pdp-instock-notice">
                <span class="pdp-instock-dot" aria-hidden="true"></span>
                {{ 'products.product.in_stock_notice' | t }}
              </p>
            {%- endif -%}
          </div>
        </div>

        <div class="pdp-info-right">
          {%- assign has_attributes = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'attribute' -%}
              {%- assign has_attributes = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_attributes -%}
            <div class="pdp-attributes">
              {%- for block in section.blocks -%}
                {%- if block.type == 'attribute' -%}
                  <div class="pdp-attribute" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon != blank -%}
                      <div class="pdp-attribute-icon">
                        {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', width: block.settings.icon.width, height: block.settings.icon.height }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                      <div class="pdp-attribute-text">
                        {%- if block.settings.title != blank -%}
                          <span class="pdp-attribute-title text-cap text-mini">{{ block.settings.title }}</span>
                        {%- endif -%}
                        {%- if block.settings.subtitle != blank -%}
                          <span class="pdp-attribute-subtitle text-mini">{{ block.settings.subtitle }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if product.description != blank -%}
            <div class="typeset">{{ product.description }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endform -%}
  </product-form>

  {%- comment -%} — Collection products + accordions — {%- endcomment -%}
  {%- liquid
    assign pdp_collection = null
    if product.tags contains 'saffra'
      assign pdp_collection = collections.saffra
    elsif product.tags contains 'viridis'
      assign pdp_collection = collections.viridis
    elsif product.tags contains 'rubra'
      assign pdp_collection = collections.rubra
    endif
  -%}

  {%- assign has_accordions = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'accordion' -%}
      {%- assign has_accordions = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign bundle_products = product.metafields.custom.bundle_includes.value -%}
  {%- assign has_bundle_includes = false -%}
  {%- if bundle_products != blank and bundle_products.size > 0 -%}
    {%- assign has_bundle_includes = true -%}
  {%- endif -%}

  {%- if has_accordions or pdp_collection != blank or has_bundle_includes -%}
    <div class="pdp-collection">
      <div class="pdp-collection-left">
        {%- if has_accordions -%}
          <span class="text-cap">{{ 'products.product.details_heading' | t }}</span>
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' and block.settings.content != blank -%}
              <details class="pdp-dropdown" {{ block.shopify_attributes }}>
                <summary class="pdp-dropdown-summary text-medium">
                  {{ block.settings.heading }}
                  <span class="pdp-dropdown-icon" aria-hidden="true">+</span>
                </summary>
                <div class="pdp-dropdown-content">
                  <div class="pdp-dropdown-body typeset">{{ block.settings.content }}</div>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="pdp-collection-right">
        {%- if has_bundle_includes -%}
          {% render 'bundle-includes', product: product %}
        {%- endif -%}

        {%- if pdp_collection != blank -%}
          <span class="text-cap">{{ pdp_collection.title }} collection</span>
          <div class="pdp-collection-grid">
            {%- comment -%} Bundles first {%- endcomment -%}
            {%- for coll_product in pdp_collection.products -%}
              {%- if coll_product.handle != product.handle and coll_product.type == 'Bundles' -%}
                {% render 'product-card', product: coll_product, lazy_load: true %}
              {%- endif -%}
            {%- endfor -%}
            {%- for coll_product in pdp_collection.products -%}
              {%- if coll_product.handle != product.handle and coll_product.type != 'Bundles' -%}
                {% render 'product-card', product: coll_product, lazy_load: true %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script src="{{ 'back-in-stock.js' | asset_url }}" defer></script>
<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
<script src="{{ 'product-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-selector.js' | asset_url }}" defer></script>
<script
  src="{{ 'klaviyo-reviews-dropdown.js' | asset_url }}"
  data-open-label="{{ 'products.product.reviews_open' | t }}"
  data-close-label="{{ 'products.product.reviews_close' | t }}"
  defer
></script>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var tagWrapper = document.querySelector('[data-color-tag]');
    if (!tagWrapper) return;

    var trigger = tagWrapper.querySelector('[data-color-trigger]');
    var popover = tagWrapper.querySelector('[data-color-popover]');
    if (!trigger || !popover) return;

    var isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

    function show() {
      popover.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    }

    function hide() {
      popover.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    }

    if (!isTouch) {
      tagWrapper.addEventListener('mouseenter', show);
      tagWrapper.addEventListener('mouseleave', hide);
    }

    trigger.addEventListener('click', function () {
      if (popover.classList.contains('is-open')) {
        hide();
      } else {
        show();
      }
    });
  });
{% endjavascript %}

{% stylesheet %}
  .main-product {
    /* padding-top: calc(var(--header-height, 80px) + var(--spacing-2)); */
    overflow: hidden;
  }

  .pdp-media {
    width: 100%;
    aspect-ratio: 3 / 4;
    max-height: 75vh;
    overflow: hidden;
    position: relative;
  }

  .pdp-tags {
    position: absolute;
    bottom: var(--spacing-2);
    left: var(--spacing-2);
    display: flex;
    gap: var(--spacing-1);
    z-index: 1;
  }

  .pdp-tag-wrapper {
    position: relative;
  }

  .tag-popover {
    position: absolute;
    bottom: 100%;
    padding-bottom: var(--spacing-1);
    left: 0;
    display: flex;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.2s ease-out, transform 0.2s ease-out;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .tag-popover-item {
    background-color: hsla(45, 33%, 85%, 0.85);
    backdrop-filter: blur(var(--blur-md));
    -webkit-backdrop-filter: blur(var(--blur-md));
    padding: var(--spacing-1) var(--spacing-2);
    font-size: var(--font-base-size);
    display: flex;
    align-items: center;
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-fast);
  }

  .tag-popover-item:hover {
    background-color: hsla(45, 33%, 75%, 0.9);
  }

  .pdp-tag {
    background-color: hsla(45, 33%, 85%, 0.85);
    backdrop-filter: blur(var(--blur-md));
    -webkit-backdrop-filter: blur(var(--blur-md));
    padding: var(--spacing-1) var(--spacing-2);
    font-size: var(--font-base-size);
    display: flex;
    align-items: center;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .pdp-tag:hover {
    background-color: hsla(45, 33%, 75%, 0.9);
  }

  .pdp-swatch {
    width: 12px;
    height: 12px;
    margin-right: 8px;
  }

  .pdp-info {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2);
    align-items: start;
    padding: var(--spacing-3) var(--spacing-2);
  }

  @media (min-width: 750px) {
    .pdp-info {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pdp-info-left {
    display: grid;
    gap: var(--spacing-2);
    justify-items: start;
  }

  .pdp-header {
    display: grid;
    gap: var(--spacing-1);
  }

  .pdp-price {
    font-size: var(--font-medium-size);
    line-height: var(--font-medium-height);
  }

  .pdp-info-right {
    color: var(--color-text);
  }

  .pdp-info-right .typeset {
    max-width: 65ch;
  }

  .pdp-attributes {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: var(--spacing-2);
    width: 100%;
    margin-top: var(--spacing-3);
  }

  .pdp-attribute:first-child {
    justify-self: start;
  }

  .pdp-attribute:not(:first-child):not(:last-child) {
    justify-self: center;
  }

  .pdp-attribute:last-child {
    justify-self: end;
  }

  @media (min-width: 750px) {
    .pdp-attributes {
      display: flex;
      justify-content: space-between;
      margin-top: 0;
      padding-right: var(--spacing-4);
    }
  }

  .pdp-attributes + .typeset {
    margin-top: calc(var(--spacing-2) + var(--spacing-1));
  }

  @media (min-width: 750px) {
    .pdp-attributes + .typeset {
      margin-top: var(--spacing-3);
    }
  }

  .pdp-attribute {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    text-align: center;
  }

  .pdp-attribute-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pdp-attribute-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp-attribute-text {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    gap: 0;
  }

  .pdp-attribute-title {
    color: var(--color-text);
  }

  .pdp-attribute-subtitle {
    color: var(--color-text);
  }

  .pdp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--spacing-2);
  }

  .notify-me {
    width: 100%;
    max-width: 65ch;
    display: grid;
    gap: var(--spacing-1);
  }

  .notify-me-prompt {
    color: var(--color-text-muted);
  }

  /* Inline submit inset into the field, matching the footer newsletter form */
  .notify-me-input-wrap {
    display: flex;
    align-items: center;
    position: relative;
  }

  .notify-me-input-wrap .input {
    width: 100%;
    padding-right: 90px;
  }

  .notify-me-submit {
    position: absolute;
    right: var(--spacing-1);
    padding: var(--spacing-1);
    color: var(--color-text-muted);
    font-size: var(--font-mini-size);
    transition: color var(--transition-fast);
  }

  .notify-me-submit:hover {
    color: var(--color-accent);
  }

  .notify-me-submit:disabled {
    opacity: 0.6;
    pointer-events: none;
  }

  .notify-me-submit.is-loading {
    color: transparent;
  }

  .notify-me-submit.is-loading::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border: 2px solid var(--color-text-muted);
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  .notify-me.is-subscribed .notify-me-prompt,
  .notify-me.is-subscribed .notify-me-input-wrap {
    display: none;
  }

  .pdp-actions .buy-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-1);
    align-items: stretch;
  }

  .preorder-ship-date {
    width: 100%;
    color: var(--color-text-muted);
    font-size: var(--font-mini-size);
  }

  .pdp-payment-terms {
    margin-top: 0;
    font-size: var(--font-mini-size);
    color: var(--color-text-muted);
  }

  .pdp-payment-terms klarna-placement::part(osm-container) {
    background-color: transparent;
    border: none;
    padding: 0;
    justify-content: flex-start;
    align-items: flex-start;
    text-align: left;
  }

  .pdp-payment-terms klarna-placement::part(osm-message) {
    font-family: var(--font-body);
    font-size: var(--font-mini-size);
    color: var(--color-text-muted);
    text-align: left;
  }

  .pdp-payment-terms klarna-placement::part(osm-legal) {
    font-family: var(--font-body);
    font-size: var(--font-mini-size);
    color: var(--color-text-muted);
    text-align: left;
  }

  .pdp-payment-terms klarna-placement::part(osm-cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
    width: 14px;
    height: 14px;
    padding: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--color-text-muted);
    font-size: 0;
    text-decoration: none;
  }

  .pdp-payment-terms klarna-placement::part(osm-cta)::after {
    content: "i";
    font-family: var(--font-body);
    font-style: italic;
    font-size: 10px;
  }

  .pdp-status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2);
    margin-top: var(--spacing-1);
  }

  .pdp-instock-notice {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    color: var(--color-text);
  }

  .pdp-instock-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: var(--color-green);
  }

  .pdp-promo-message {
    display: inline-block;
    max-width: 80ch;
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 5%, transparent);
    padding: var(--spacing-1);
  }

  .pdp-collection {
    padding: var(--spacing-4) var(--spacing-2);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2);
    align-items: start;
  }

  @media (min-width: 750px) {
    .pdp-collection {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pdp-collection-left {
    max-width: 65ch;
  }

  .pdp-collection-left > .text-cap,
  .pdp-collection-right > .text-cap {
    display: block;
    margin-bottom: var(--spacing-2);
  }

  .pdp-collection-left > .text-cap + .pdp-dropdown summary {
    padding-top: 0;
  }

  .pdp-collection-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-3) var(--spacing-2);
  }

  @media (min-width: 1024px) {
    .pdp-collection-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pdp-dropdown + .pdp-dropdown {
    border-top: 1px solid var(--color-text);
  }

  .pdp-dropdown summary {
    padding: var(--spacing-2) 0;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    text-align: left;
    list-style: none;
  }

  .pdp-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .pdp-dropdown-icon {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
    font-size: var(--font-base-size);
    line-height: 1;
  }

  details[open] .pdp-dropdown-icon {
    transform: rotate(45deg);
  }

  .pdp-dropdown-body {
    padding-bottom: var(--spacing-2);
    /* display: grid; */
    /* gap: var(--spacing-1); */
    /* line-height: 1.6; */
  }

  #klaviyo-product-reviews-wrapper.is-dropdown {
    border-top: 1px solid var(--color-text);
  }

  #klaviyo-product-reviews-wrapper.is-dropdown .kl_reviews__summary {
    cursor: pointer;
  }

  #klaviyo-product-reviews-wrapper.is-dropdown .kl_reviews__summary__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #klaviyo-product-reviews-wrapper.is-dropdown .kl-reviews-toggle {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--font-base-size);
    line-height: var(--font-base-height);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
  }

  #klaviyo-product-reviews-wrapper.is-dropdown:not(.is-open) .kl_reviews__reviews_list {
    display: none;
  }

  product-form.is-loading [data-variant-render] {
    opacity: 0.6;
    pointer-events: none;
  }

  .variant-options {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .tag-popover.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .bundle-includes {
    margin-bottom: var(--spacing-3);
    max-width: 65ch;
  }

  .bundle-includes > .text-cap {
    display: block;
    margin-bottom: var(--spacing-2);
  }

  .bundle-includes-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bundle-includes-item {
    border-top: 1px solid var(--color-text);
  }

  .bundle-includes-link {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: var(--spacing-2);
    align-items: start;
    padding: var(--spacing-2) 0;
    text-decoration: none;
    color: inherit;
  }

  .bundle-includes-thumb {
    width: 96px;
    height: 96px;
    overflow: hidden;
    background-color: var(--color-input-bg);
  }

  .bundle-includes-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bundle-includes-info {
    min-width: 0;
  }

  .bundle-includes-title {
    font-size: var(--font-base-size);
    line-height: var(--font-base-height);
  }

  .bundle-includes-excerpt {
    margin: var(--spacing-1) 0 0;
    font-size: var(--font-mini-size);
    line-height: var(--font-mini-height);
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bundle-includes-read-more {
    display: inline-block;
    margin-top: var(--spacing-1);
    font-size: var(--font-mini-size);
    line-height: var(--font-mini-height);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .bundle-includes-qty {
    font-size: var(--font-base-size);
    line-height: var(--font-base-height);
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-popover-item,
    .pdp-tag,
    .tag-popover {
